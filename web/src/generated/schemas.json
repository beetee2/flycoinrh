{
  "BenchmarkReport": {
    "$defs": {
      "BenchmarkMetrics": {
        "additionalProperties": false,
        "properties": {
          "infrastructure_failures": {
            "maximum": 1000000,
            "minimum": 0,
            "title": "Infrastructure Failures",
            "type": "integer"
          },
          "mean_steps_all_episodes": {
            "maximum": 1000000,
            "minimum": 0,
            "title": "Mean Steps All Episodes",
            "type": "number"
          },
          "scheduled_episodes": {
            "maximum": 1000000,
            "minimum": 1,
            "title": "Scheduled Episodes",
            "type": "integer"
          },
          "schema_version": {
            "const": "1",
            "title": "Schema Version",
            "type": "string"
          },
          "success_fraction": {
            "maximum": 1,
            "minimum": 0,
            "title": "Success Fraction",
            "type": "number"
          },
          "timeout_fraction": {
            "maximum": 1,
            "minimum": 0,
            "title": "Timeout Fraction",
            "type": "number"
          },
          "total_wall_ms": {
            "maximum": 1000000000,
            "minimum": 0,
            "title": "Total Wall Ms",
            "type": "number"
          },
          "wrong_pad_fraction": {
            "maximum": 1,
            "minimum": 0,
            "title": "Wrong Pad Fraction",
            "type": "number"
          }
        },
        "required": [
          "schema_version",
          "scheduled_episodes",
          "success_fraction",
          "wrong_pad_fraction",
          "timeout_fraction",
          "infrastructure_failures",
          "mean_steps_all_episodes",
          "total_wall_ms"
        ],
        "title": "BenchmarkMetrics",
        "type": "object"
      },
      "Uncertainty": {
        "additionalProperties": false,
        "properties": {
          "confidence_level": {
            "const": 0.95,
            "title": "Confidence Level",
            "type": "number"
          },
          "lower": {
            "maximum": 1,
            "minimum": -1,
            "title": "Lower",
            "type": "number"
          },
          "method": {
            "enum": [
              "paired_layout_bootstrap",
              "not_estimated"
            ],
            "title": "Method",
            "type": "string"
          },
          "schema_version": {
            "const": "1",
            "title": "Schema Version",
            "type": "string"
          },
          "upper": {
            "maximum": 1,
            "minimum": -1,
            "title": "Upper",
            "type": "number"
          }
        },
        "required": [
          "schema_version",
          "method",
          "confidence_level",
          "lower",
          "upper"
        ],
        "title": "Uncertainty",
        "type": "object"
      }
    },
    "$id": "https://flytrap.invalid/contracts/v1/BenchmarkReport",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "checkpoint_sha256": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "title": "Checkpoint Sha256",
        "type": "string"
      },
      "claim_status": {
        "enum": [
          "SUPPORTED",
          "UNSUPPORTED",
          "INCONCLUSIVE",
          "NOT_RUN"
        ],
        "title": "Claim Status",
        "type": "string"
      },
      "cohorts": {
        "items": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "type": "string"
        },
        "maxItems": 1024,
        "minItems": 1,
        "title": "Cohorts",
        "type": "array"
      },
      "layouts": {
        "items": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])",
          "type": "string"
        },
        "maxItems": 4096,
        "minItems": 1,
        "title": "Layouts",
        "type": "array"
      },
      "limitations": {
        "items": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 32,
        "minItems": 1,
        "title": "Limitations",
        "type": "array"
      },
      "metrics": {
        "$ref": "#/$defs/BenchmarkMetrics"
      },
      "model_sha256": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "title": "Model Sha256",
        "type": "string"
      },
      "preregistration_sha256": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "title": "Preregistration Sha256",
        "type": "string"
      },
      "report_id": {
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])",
        "title": "Report Id",
        "type": "string"
      },
      "schema_version": {
        "const": "1",
        "title": "Schema Version",
        "type": "string"
      },
      "seeds": {
        "items": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 4096,
        "minItems": 1,
        "title": "Seeds",
        "type": "array"
      },
      "source_tree_sha256": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "title": "Source Tree Sha256",
        "type": "string"
      },
      "uncertainty": {
        "$ref": "#/$defs/Uncertainty"
      }
    },
    "required": [
      "schema_version",
      "report_id",
      "preregistration_sha256",
      "source_tree_sha256",
      "model_sha256",
      "checkpoint_sha256",
      "cohorts",
      "layouts",
      "seeds",
      "metrics",
      "uncertainty",
      "limitations",
      "claim_status"
    ],
    "title": "BenchmarkReport",
    "type": "object"
  },
